# Blood Bank Web App — copy to .env and fill in. NEVER commit a real .env.
# All values here are names/examples only — no real secrets.

# --- Database ---
DATABASE_URL=postgresql+psycopg://bloodbank:bloodbank_dev@localhost:5432/bloodbank
POSTGRES_USER=bloodbank
POSTGRES_PASSWORD=bloodbank_dev
POSTGRES_DB=bloodbank

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_TOKEN_EXPIRE_MINUTES=5

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Seed (DEV ONLY) ---
SEED_ADMIN_EMAIL=admin@bloodbank.local
SEED_ADMIN_PASSWORD=Admin@123456

# --- Environment ---
ENVIRONMENT=development
